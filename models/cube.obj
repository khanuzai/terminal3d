# A 2x2x2 cube centered at the origin.
# Each face is a quad (4 corners), so the loader should split it into
# 2 triangles: 8 vertices, 12 triangles in total.
# Corners are listed counter-clockwise as seen from outside the cube.
# The faces deliberately use every corner format the loader supports.

v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0  0  1
vn  0  0 -1
vn  1  0  0
vn -1  0  0
vn  0  1  0
vn  0 -1  0

# front and back: v/vt/vn
f 1/1/1 2/2/1 3/3/1 4/4/1
f 6/1/2 5/2/2 8/3/2 7/4/2
# right and left: v//vn
f 2//3 6//3 7//3 3//3
f 5//4 1//4 4//4 8//4
# top: v/vt
f 4/1 3/2 7/3 8/4
# bottom: plain v
f 5 6 2 1
